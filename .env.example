# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# The token's contract address (mint). Leave blank until launch.
TOKEN_MINT=

# Display names (optional)
BOT_NAME=GIGA
TOKEN_TICKER=GIGA

# CoinGecko key and plan ("demo" or "pro")
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# Solana RPC used for tipping. A free Helius/QuickNode URL is strongly
# recommended; the public endpoint rate-limits heavily.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
