# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# The token's contract address (mint). Leave blank until launch.
TOKEN_MINT=

# Display names (optional)
BOT_NAME=GIGAFUNBOT
TOKEN_TICKER=GIGA

# CoinGecko key and plan ("demo" or "pro")
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# Solana RPC used for tipping. A free Helius/QuickNode URL is strongly
# recommended; the public endpoint rate-limits heavily.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ---------- GIGA trading bot ----------
# Master switch. The bot does nothing until this is "true".
BOT_ENABLED=false
# Practice mode: GIGA judges and replies but makes NO real trades.
# Leave "true" until you've watched it work, then set to "false".
BOT_DRY_RUN=true

# Secret that the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
# Make it long and random.
CRON_SECRET=

# Claude API key (console.anthropic.com) and model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Jupiter API key (free at portal.jup.ag), used to execute buys
JUPITER_API_KEY=

# Private key of a NEW, dedicated hot wallet (base58 or [1,2,...] array).
# Only keep a small amount of SOL in it.
BOT_PRIVATE_KEY=

# Upstash Redis (added automatically by Vercel Marketplace → Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Behavior and limits
BOT_HANDLE=GIGA
BOT_BUY_USD=2
BOT_MAX_BUYS_PER_DAY=10
BOT_MAX_PER_TICK=3
BOT_USER_COOLDOWN_MINUTES=60
BOT_MIN_AGE_MINUTES=15
BOT_MIN_MCAP_USD=8000
BOT_MAX_MCAP_USD=50000000

# Optional: also post every verdict to a Telegram channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: your public site URL for links in Telegram posts
SITE_URL=

# ---------- pump.fun comments address (optional) ----------
# If callouts show a 404, paste pump.fun's current comments URL here with
# {mint}, {limit} and {offset} in place of the real values.
PUMP_REPLIES_URL=
